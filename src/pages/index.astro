
---
import "../styles/global.css";
import DeveloperStatus from "../components/DeveloperStatus.astro";

const skills = [
  {
    category: "Cloud & Infrastructure",
    items: ["AWS", "EC2", "S3", "IAM", "VPC", "Lambda"],
  },
  {
    category: "Networking",
    items: ["TCP/IP", "DNS", "Subnetting", "Routing", "Network Troubleshooting"],
  },
  {
    category: "Development & Tools",
    items: ["Python", "Java", "C", "Git", "HTML", "CSS"],
  },
];

const experience = [
  {
    role: "Credit Card Associate",
    company: "JPMorgan Chase",
    period: "2026 — Present",
    description:
      "Supporting customers in a regulated financial services environment, resolving account issues, and delivering accurate solutions.",
  },
  {
    role: "Technical Support Advisor",
    company: "Concentrix",
    period: "Previous Role",
    description:
      "Troubleshot technical issues, guided customers through solutions, and communicated technical concepts clearly.",
  },
  {
    role: "Deli Team Lead",
    company: "Publix",
    period: "2021 — 2025",
    description:
      "Supported daily operations, team coordination, customer service, and problem resolution.",
  },
];

const certifications = [
  {
    title: "AWS Certified Cloud Practitioner",
    organization: "Amazon Web Services",
  },
  {
    title: "CompTIA Network+",
    organization: "CompTIA",
  },
  {
    title: "B.A.S. Computing Technology & Software Development",
    organization: "Valencia College · Expected May 2027",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0B1020" />
    <meta
      name="description"
      content="Elijah Davids — AWS Certified Cloud Practitioner, CompTIA Network+ certified, and aspiring cloud infrastructure engineer."
    />
    <title>Elijah Davids | Cloud & Infrastructure</title>
  </head>

  <body class="bg-[#0B1020] text-slate-100 antialiased">
    <!-- NAVIGATION -->
    <header
      class="sticky top-0 z-50 border-b border-slate-800/70 bg-[#0B1020]/90 backdrop-blur-lg"
    >
      <nav
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5"
      >
        <a href="#" class="text-2xl font-bold tracking-tight" aria-label="Back to top">
          ED<span class="text-violet-400">.</span>
        </a>

        <div class="flex flex-wrap gap-4 text-sm text-slate-300 md:gap-6">
          <a href="#about" class="nav-link">About</a>
          <a href="#projects" class="nav-link">Projects</a>
          <a href="#experience" class="nav-link">Experience</a>
          <a href="#skills" class="nav-link">Skills</a>
          <a href="#contact" class="nav-link">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <!-- HERO -->
      <section
        class="hero-gradient relative overflow-hidden"
        aria-labelledby="hero-heading"
      >
        <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
          <div class="hero-orb hero-orb-blue" aria-hidden="true"></div>
          <div class="hero-orb hero-orb-violet" aria-hidden="true"></div>

          <div
            class="relative z-10 grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_440px]"
          >
            <!-- LEFT: INTRODUCTION -->
            <div class="min-w-0">
              <p
                class="hero-animate mb-6 font-mono text-sm tracking-widest text-sky-400"
              >
                CLOUD COMPUTING / INFRASTRUCTURE / AWS
              </p>

              <h1
                id="hero-heading"
                class="hero-animate hero-delay-1 text-5xl font-bold tracking-tight sm:text-6xl xl:text-7xl"
              >
                Hi, I'm <span class="gradient-text">Elijah.</span>
              </h1>

              <h2
                class="hero-animate hero-delay-2 mt-6 text-2xl font-semibold text-slate-200 md:text-3xl"
              >
                Aspiring Cloud & Infrastructure Engineer.
              </h2>

              <p
                class="hero-animate hero-delay-2 mt-7 max-w-2xl text-lg leading-8 text-slate-300"
              >
                AWS Certified Cloud Practitioner and CompTIA Network+ certified.
                Passionate about cloud infrastructure, networking, and solving
                complex technical problems.
              </p>

              <div class="hero-animate hero-delay-3 mt-10 flex flex-wrap gap-4">
                <a
                  href="#projects"
                  class="gradient-hover inline-flex items-center rounded-lg bg-sky-400 px-7 py-3 font-semibold text-slate-950"
                >
                  Explore My Work →
                </a>

                <a
                  href="#contact"
                  class="secondary-button inline-flex items-center rounded-lg border border-violet-400/60 px-7 py-3 font-semibold text-violet-200"
                >
                  Contact Me
                </a>
              </div>
            </div>

            <!-- RIGHT: LIVE STATUS -->
            <div class="hero-animate hero-delay-3 flex justify-center lg:justify-end">
              <DeveloperStatus />
            </div>
          </div>
        </div>
      </section>

      <!-- 01 ABOUT -->
      <section
        id="about"
        class="scroll-mt-24 border-y border-slate-800 bg-[#111B30]"
      >
        <div class="reveal mx-auto max-w-6xl px-6 py-20">
          <p class="font-mono text-sm text-violet-400">01 / ABOUT</p>

          <h2 class="mt-3 text-4xl font-bold">About Me</h2>

          <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-300">
            I'm pursuing a Bachelor of Applied Science in Computing
            Technology and Software Development, concentrating in Cloud
            Computing at Valencia College, with an expected graduation
            date of May 2027.
          </p>

          <p class="mt-5 max-w-3xl leading-8 text-slate-400">
            My professional background combines technical troubleshooting,
            customer support, and operational experience. I'm focused on
            developing the skills needed to build, manage, and secure
            modern cloud infrastructure.
          </p>
        </div>
      </section>

      <!-- 02 PROJECTS -->
      <section
        id="projects"
        class="reveal scroll-mt-24 mx-auto max-w-6xl px-6 py-24"
      >
        <p class="font-mono text-sm text-sky-400">02 / PROJECTS</p>

        <h2 class="mt-3 text-4xl font-bold">Featured Projects</h2>

        <p class="mt-4 max-w-2xl leading-7 text-slate-400">
          Independent projects documenting my development, technical
          problem-solving, and cloud engineering journey.
        </p>

        <article
          class="project-card-animated gradient-border mt-10 rounded-xl p-8 md:p-10"
        >
          <div class="flex flex-wrap items-center justify-between gap-4">
            <p class="font-mono text-sm text-sky-400">
              PROJECT 001 / WEB DEVELOPMENT
            </p>

            <span
              class="rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs font-medium text-sky-300"
            >
              Deployed
            </span>
          </div>

          <h3 class="mt-5 text-2xl font-bold md:text-3xl">
            Personal Portfolio & Deployment Pipeline
          </h3>

          <p class="mt-4 max-w-2xl leading-7 text-slate-400">
            Designed and developed a responsive professional portfolio
            using Astro and Tailwind CSS. Implemented automated deployments
            through GitHub and Vercel, with custom-domain DNS management
            through Cloudflare.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {[
              "Astro",
              "Tailwind CSS",
              "Git",
              "GitHub",
              "Vercel",
              "Cloudflare",
            ].map((tech) => (
              <span class="rounded-md bg-sky-400/10 px-3 py-2 text-sm text-sky-300">
                {tech}
              </span>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/projects/cloud-portfolio"
              class="gradient-hover inline-flex items-center rounded-lg bg-sky-400 px-6 py-3 font-semibold text-slate-950"
            >
              Read Case Study →
            </a>

            <a
              href="https://github.com/ElijahDavids/cloud-portfolio"
              target="_blank"
              rel="noopener noreferrer"
              class="secondary-button inline-flex items-center rounded-lg border border-slate-700 px-6 py-3 font-semibold"
            >
              View Source Code ↗
            </a>
          </div>
        </article>

        <!-- ANIMATED DEPLOYMENT ARCHITECTURE -->
        <div class="reveal mt-20">
          <p class="font-mono text-sm text-violet-400">
            DEPLOYMENT ARCHITECTURE
          </p>

          <h3 class="mt-3 text-2xl font-bold">
            From Source Code to Live Website
          </h3>

          <p class="mt-3 max-w-3xl leading-7 text-slate-400">
            GitHub stores the source code. A push triggers Vercel to build
            and host the site. Cloudflare manages the DNS record that
            points my custom domain to Vercel.
          </p>

          <div
            class="architecture-panel mt-8 rounded-2xl border border-slate-700/80 p-5 md:p-8"
          >
            <div
              class="architecture-flow grid items-center gap-3 md:grid-cols-[1fr_56px_1fr_56px_1fr]"
            >
              <div
                class="infrastructure-node rounded-xl border border-sky-400/40 bg-[#111B30] p-6 text-center"
              >
                <div class="mb-2 text-2xl" aria-hidden="true">⌘</div>
                <h4 class="text-lg font-bold text-slate-100">GitHub</h4>
                <p class="mt-1 text-sm text-slate-400">Source control</p>
              </div>

              <svg
                class="architecture-connector mx-auto h-8 w-12 rotate-90 md:rotate-0"
                viewBox="0 0 56 32"
                aria-hidden="true"
              >
                <path
                  class="infrastructure-line"
                  d="M2 16 H48"
                  fill="none"
                  stroke="#38BDF8"
                  stroke-width="2"
                />
                <path
                  d="m42 10 8 6-8 6"
                  fill="none"
                  stroke="#A78BFA"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>

              <div
                class="infrastructure-node rounded-xl border border-violet-400/50 bg-[#17172F] p-6 text-center"
              >
                <div class="mb-2 text-2xl" aria-hidden="true">◇</div>
                <h4 class="text-lg font-bold text-slate-100">Vercel</h4>
                <p class="mt-1 text-sm text-slate-400">Build & Hosting</p>
              </div>

              <svg
                class="architecture-connector mx-auto h-8 w-12 rotate-90 md:rotate-0"
                viewBox="0 0 56 32"
                aria-hidden="true"
              >
                <path
                  class="infrastructure-line"
                  d="M2 16 H48"
                  fill="none"
                  stroke="#A78BFA"
                  stroke-width="2"
                />
                <path
                  d="m42 10 8 6-8 6"
                  fill="none"
                  stroke="#38BDF8"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>

              <div
                class="infrastructure-node rounded-xl border border-sky-400/40 bg-[#111B30] p-6 text-center"
              >
                <div class="mb-2 text-2xl" aria-hidden="true">◎</div>
                <h4 class="text-lg font-bold text-slate-100">Cloudflare</h4>
                <p class="mt-1 text-sm text-slate-400">Custom-Domain DNS</p>
              </div>
            </div>

            <p class="mt-6 text-center text-xs text-slate-400">
              Deployment: GitHub → Vercel · DNS: Cloudflare → Vercel-hosted site
            </p>
          </div>
        </div>
      </section>

      <!-- 03 EXPERIENCE -->
      <section
        id="experience"
        class="scroll-mt-24 border-y border-slate-800 bg-[#111B30]"
      >
        <div class="reveal mx-auto max-w-6xl px-6 py-24">
          <p class="font-mono text-sm text-violet-400">03 / CAREER</p>

          <h2 class="mt-3 text-4xl font-bold">
            Professional Experience
          </h2>

          <div class="mt-12 space-y-10 border-l border-sky-400/40 pl-8">
            {experience.map((job) => (
              <article class="relative">
                <span
                  class="absolute -left-[39px] top-2 h-4 w-4 rounded-full border-4 border-[#111B30] bg-violet-400"
                ></span>

                <p class="font-mono text-sm text-sky-400">
                  {job.period}
                </p>

                <h3 class="mt-2 text-2xl font-semibold">
                  {job.role}
                </h3>

                <p class="mt-1 text-slate-300">
                  {job.company}
                </p>

                <p class="mt-4 max-w-2xl leading-7 text-slate-400">
                  {job.description}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 04 SKILLS -->
      <section
        id="skills"
        class="reveal scroll-mt-24 mx-auto max-w-6xl px-6 py-24"
      >
        <p class="font-mono text-sm text-sky-400">04 / TOOLKIT</p>

        <h2 class="mt-3 text-4xl font-bold">Technical Skills</h2>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {skills.map((group) => (
            <div
              class="project-card-animated rounded-xl border border-slate-700 bg-[#111B30] p-7"
            >
              <h3 class="text-xl font-semibold">
                {group.category}
              </h3>

              <div class="mt-6 flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <span
                    class="rounded-md bg-sky-400/10 px-3 py-2 text-sm text-sky-300"
                  >
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 05 CERTIFICATIONS -->
      <section class="border-y border-slate-800 bg-[#111B30]">
        <div class="reveal mx-auto max-w-6xl px-6 py-24">
          <p class="font-mono text-sm text-violet-400">
            05 / QUALIFICATIONS
          </p>

          <h2 class="mt-3 text-4xl font-bold">
            Certifications & Education
          </h2>

          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {certifications.map((cert) => (
              <div
                class="project-card-animated rounded-xl border border-slate-700 bg-[#0B1020] p-7"
              >
                <h3 class="text-lg font-semibold">
                  {cert.title}
                </h3>

                <p class="mt-2 text-sm text-slate-400">
                  {cert.organization}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 06 CONTACT -->
      <section
        id="contact"
        class="reveal scroll-mt-24 px-6 py-24 text-center"
      >
        <p class="font-mono text-sm text-sky-400">
          06 / CONNECT
        </p>

        <h2 class="mt-4 text-4xl font-bold">
          Let's Connect.
        </h2>

        <p class="mx-auto mt-5 max-w-xl leading-8 text-slate-400">
          I'm open to early-career opportunities in cloud computing,
          IT infrastructure, and technical operations. Feel free to reach out!
        </p>

        <div class="mt-9 flex items-center justify-center gap-4">
          <!-- EMAIL -->
          <a
            href="mailto:contact@elijahdavids.com?subject=Portfolio%20Inquiry"
            aria-label="Send me an email"
            title="Email"
            class="group flex h-14 w-14 items-center justify-center rounded-xl border border-violet-400/30 bg-[#111B30] text-slate-300 transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/70 hover:bg-sky-400/10 hover:text-sky-400 hover:shadow-lg hover:shadow-sky-500/10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="25"
              height="25"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 7L2 7" />
            </svg>
          </a>

          <!-- LINKEDIN -->
          <a
            href="https://www.linkedin.com/in/elijahdavids/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit my LinkedIn profile"
            title="LinkedIn"
            class="group flex h-14 w-14 items-center justify-center rounded-xl border border-violet-400/30 bg-[#111B30] text-slate-300 transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/70 hover:bg-sky-400/10 hover:text-sky-400 hover:shadow-lg hover:shadow-sky-500/10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="25"
              height="25"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>

          <!-- GITHUB -->
          <a
            href="https://github.com/ElijahDavids"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit my GitHub profile"
            title="GitHub"
            class="group flex h-14 w-14 items-center justify-center rounded-xl border border-violet-400/30 bg-[#111B30] text-slate-300 transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/70 hover:bg-sky-400/10 hover:text-sky-400 hover:shadow-lg hover:shadow-sky-500/10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="25"
              height="25"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 .5C5.649.5.5 5.649.5 12c0 5.081 3.292 9.392 7.863 10.913.575.106.785-.25.785-.555 0-.274-.01-1-.016-1.962-3.198.695-3.874-1.54-3.874-1.54-.523-1.329-1.277-1.683-1.277-1.683-1.044-.714.079-.7.079-.7 1.155.081 1.763 1.186 1.763 1.186 1.027 1.761 2.694 1.252 3.35.958.104-.744.402-1.252.732-1.54-2.553-.29-5.238-1.276-5.238-5.686 0-1.256.45-2.282 1.186-3.087-.12-.291-.514-1.46.113-3.044 0 0 .967-.31 3.17 1.18a11.04 11.04 0 0 1 5.77 0c2.202-1.49 3.167-1.18 3.167-1.18.629 1.584.235 2.753.116 3.044.739.805 1.185 1.831 1.185 3.087 0 4.421-2.69 5.393-5.25 5.678.413.357.78 1.061.78 2.138 0 1.544-.014 2.789-.014 3.169 0 .308.207.667.79.554C20.21 21.388 23.5 17.08 23.5 12 23.5 5.649 18.351.5 12 .5Z" />
            </svg>
          </a>
        </div>

        <p class="mt-5 text-xs text-slate-500">
          Email · LinkedIn · GitHub
        </p>
      </section>
    </main>

    <!-- FOOTER -->
    <footer
      class="border-t border-slate-800 py-8 text-center text-sm text-slate-500"
    >
      © {new Date().getFullYear()} Elijah Davids. Built with Astro.
    </footer>

    <!-- SCROLL REVEAL SCRIPT -->
    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!reduceMotion && "IntersectionObserver" in window) {
        const elements = document.querySelectorAll<HTMLElement>(".reveal");

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.08,
            rootMargin: "0px 0px -24px 0px",
          }
        );

        elements.forEach((element) => observer.observe(element));
        document.documentElement.classList.add("reveal-ready");
      }
    </script>
  </body>
</html>
